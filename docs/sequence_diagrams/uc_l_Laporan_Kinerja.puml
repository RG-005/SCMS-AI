@startuml
title UC-L - Memantau & Mengekspor Laporan Kinerja Infrastruktur (tabel + grafik)

actor "Kepala Bidang / Admin" as Kabid
boundary "HalamanLaporanKinerja\n(laporan_kinerja.html)" as Halaman
boundary "Chart.js 4.4.1 lokal\n(/static/js/chart.umd.js)" as Chart
control KontrolLaporanKinerja as Ctrl
entity WorkOrder
entity RiwayatStatus
entity Laporan
entity Rating

Kabid -> Halaman : 1. GET /laporan-kinerja?tanggal_mulai&tanggal_akhir&wilayah\n(form #formFilterKinerja)
activate Halaman
note right of Halaman : Hanya Admin & Kepala Bidang\n(peran lain 403, tanpa login -> /Login)
Halaman -> Ctrl : 1.1 rekap(tanggal_mulai, tanggal_akhir, wilayah)
activate Ctrl

alt Format tanggal salah / tanggal mulai setelah tanggal akhir
    Ctrl --> Halaman : 1.2 success=False + pesan (HTTP 400)
else Tanggal valid
    Ctrl -> RiwayatStatus : 1.2 waktu pertama tiap status per tiket
    Ctrl -> Laporan : 1.3 tanggal laporan pertama per tiket (cadangan waktu mulai)
    Ctrl -> Rating : 1.4 rating per tiket (satu per warga unik)
    Ctrl -> WorkOrder : 1.5 tiket (filter wilayah), lalu filter periode (tanggal WIB)
    Ctrl -> Ctrl : 1.6 pisahkan tiket Ditutup (dilaporkan terpisah per alasan)
    alt Tidak ada tiket (dan tidak ada tiket Ditutup)
        Ctrl --> Halaman : 1.7 "Tidak ada data kinerja pada periode yang dipilih"\n(tanpa grafik & tanpa tombol unduh)
    else Ada tiket
        Ctrl -> Ctrl : 1.7 KPI, durasi per tahap (durasi_tahap), tiket aktif menurut umur,\nrekap per wilayah & per prioritas, detail tiket, ringkasan Ditutup
        Ctrl -> Ctrl : 1.8 data_grafik(baris, per_wilayah, per_prioritas, total)\n(dari struktur yang SAMA dengan tabel; grafik = None bila hanya ada tiket Ditutup)
        Ctrl --> Halaman : 1.9 data rekap + grafik
    end
end
deactivate Ctrl

opt grafik tersedia
    Halaman -> Halaman : 2. sisipkan JSON #dataGrafikKinerja
    Halaman -> Chart : 2.1 muat /static/js/chart.umd.js (tanpa CDN)
    alt Chart.js termuat
        Chart --> Halaman : 2.2 4 grafik: tren masuk vs selesai per minggu (line),\ndistribusi prioritas (doughnut), rata-rata durasi per tahap (bar),\nrekap selesai/aktif per wilayah (bar)
    else Gagal dimuat
        Halaman -> Halaman : 2.2 tampilkan #grafikTidakTersedia (tabel tetap lengkap)
    end
end
Halaman --> Kabid : 3. KPI, grafik, tabel durasi tahap, tiket aktif, rekap wilayah & prioritas,\ndetail tiket, #ringkasanDitutup

alt Unduh CSV
    Kabid -> Halaman : 4. klik #unduhWilayah / #unduhTiket
    Halaman -> Ctrl : 4.1 GET /laporan-kinerja/unduh?jenis=wilayah|tiket (+ filter yang sama)\n(jenis lain -> 400)
    activate Ctrl
    Ctrl -> Ctrl : 4.2 rekap(...) lalu csv_per_wilayah() / csv_per_tiket()\n(UTF-8 BOM, aman_untuk_spreadsheet())
    Ctrl --> Halaman : 4.3 laporan_kinerja_<jenis>_<periode>.csv
    deactivate Ctrl
    Halaman --> Kabid : 4.4 unduhan CSV
else Cetak
    Kabid -> Halaman : 4. klik #cetakLaporan ("Cetak / Simpan PDF")
    Halaman --> Kabid : 4.1 window.print() (dialog cetak / PDF browser)
end
deactivate Halaman
@enduml
