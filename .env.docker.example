# Salin menjadi .env.docker lalu isi nilainya. Jangan di-commit.

# Database PostgreSQL (dibuat otomatis oleh container db)
POSTGRES_DB=scms_pupr_db
POSTGRES_USER=scms
POSTGRES_PASSWORD=ganti_password_db

# Kunci tanda tangan cookie sesi. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCMS_SECRET_KEY=ganti_dengan_string_acak_panjang

# Isi 1 jika aplikasi dilayani lewat HTTPS (di belakang Nginx/Caddy/Cloudflare)
SCMS_HTTPS_ONLY=0

# Port di host
APP_PORT=8000

# Mode AI. Bawaan: simulasi (image ringan).
# Untuk YOLOv8 v4: WITH_AI=1, SCMS_CV_BACKEND=yolov8, lalu taruh bobot di
# ./models/scms_v4/yolov8_infra_best.pt (+ model_config.json di folder yang sama).
WITH_AI=0
SCMS_CV_BACKEND=simulasi
SCMS_NLP_BACKEND=leksikal

